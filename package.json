{
  "name": "khodal-cab-be",
  "version": "1.0.0",
  "description": "Khodal Cab Backend API & Management System",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "test": "echo \"Error: no test specified\" && exit 1",
    "format": "npx prettier --write \"src/**/*.{ts,js,json}\" \"*.{json,js,ts}\"",
    "format:check": "npx prettier --check \"src/**/*.{ts,js,json}\" \"*.{json,js,ts}\""
